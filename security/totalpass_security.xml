<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_afr_totalpass" model="ir.module.category">
        <field name="name">TotalPass</field>
        <field name="description">Colaboradores TotalPass e integração Asaas</field>
    </record>

    <record id="group_afr_totalpass_user" model="res.groups">
        <field name="name">TotalPass / Usuário</field>
        <field name="category_id" ref="module_category_afr_totalpass"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_afr_totalpass_manager" model="res.groups">
        <field name="name">TotalPass / Gestor</field>
        <field name="category_id" ref="module_category_afr_totalpass"/>
        <field name="implied_ids" eval="[(4, ref('group_afr_totalpass_user'))]"/>
    </record>

    <record id="totalpass_collaborator_company_rule" model="ir.rule">
        <field name="name">TotalPass colaborador multi-empresa</field>
        <field name="model_id" ref="model_totalpass_collaborator"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="totalpass_payment_company_rule" model="ir.rule">
        <field name="name">TotalPass cobrança multi-empresa</field>
        <field name="model_id" ref="model_totalpass_asaas_payment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
